@model Shorty.Web.Models.UrlMappings

@{
    ViewData["Title"] = "Analytics";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary fw-bold">📊 Analytics</h2>
            <p class="text-muted mb-0">Dados para: <a href="@Model.OriginalUrl" target="_blank">@Model.OriginalUrl</a></p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">⬅ Voltar</a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm border-primary h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="card-title text-muted text-uppercase small">Total de Cliques</h5>
                    <h1 class="fw-bold display-4 text-primary">@Model.ClickCount</h1>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card bg-light border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div>
                        <p class="mb-1 text-muted">Seu Link Curto:</p>
                        <h4 class="mb-0">
                            <a href="/@Model.Code" target="_blank" class="fw-bold text-dark text-decoration-none">
                                @Context.Request.Scheme://@Context.Request.Host/@Model.Code
                            </a>
                        </h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Histórico de Acessos</h4>

    @if (!Model.UrlAcessLogs.Any())
    {
        <div class="alert alert-warning border-warning shadow-sm">
            Ninguém clicou neste link ainda. Compartilhe ele para ver os dados aparecerem aqui!
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="py-3 ps-4">Data / Hora (UTC)</th>
                            <th>IP</th>
                            <th>Dispositivo / Navegador</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.UrlAcessLogs.OrderByDescending(x => x.DataAcesso))
                        {
                            <tr>
                                <td class="ps-4">@log.DataAcesso.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-secondary font-monospace">
                                        @(log.IpAddress ?? "Desconhecido")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    <div class="text-truncate" style="max-width: 450px;" title="@log.UserAgent">
                                        @(log.UserAgent ?? "Desconhecido")
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>