@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4 mt-md-5"> <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">
            
            <h1 class="display-4 fw-bold text-primary mb-3 d-flex align-items-center justify-content-center">
                <a href="">
                    <img src="~/images/logo.png" alt="Logo Shorty" class="img-fluid me-3" style="max-height: 3em; width: auto;" />
                </a>
            </h1>

            <p class="lead text-muted mb-4 mb-md-5">
                Transforme links gigantes em atalhos curtos e elegantes.
            </p>

            <div class="card shadow-lg border-0">
                <div class="card-body p-4 p-md-5">
                    
                    <form asp-action="Encurtar" method="post">
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text bg-white border-end-0 text-primary">
                                🔗 
                            </span>
                            
                            <input type="url" 
                                   name="urlOriginal" 
                                   class="form-control border-start-0" 
                                   placeholder="Cole sua URL longa..." 
                                   required 
                                   value="@ViewBag.UrlOriginal" />
                            
                            <button type="submit" class="btn btn-primary fw-bold">
                                Encurtar
                            </button>
                        </div>
                    </form>

                </div>
            </div>

            @if (ViewBag.UrlCurta != null)
            {
                <div class="alert alert-success mt-4 p-3 p-md-4 shadow-sm fade show" role="alert">
                    <h4 class="alert-heading mb-3 fs-5 fs-md-4">Seu link está pronto! 🎉</h4>
                    
                    <div class="bg-white p-3 rounded border text-center">
                        <a href="@ViewBag.UrlCurta" target="_blank" class="fs-5 fs-md-4 fw-bold text-decoration-none text-success text-break">
                            @ViewBag.UrlCurta
                        </a>
                    </div>
                    
                    <p class="mb-0 mt-2 text-muted small">Clique no link acima para testar</p>
                </div>
            }

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger mt-3 fade show text-break">
                    ⚠️ @ViewBag.Erro
                </div>
            }

        </div>
    </div>
</div>