@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            
            <h1 class="display-4 fw-bold text-primary mb-3 d-flex align-items-center justify-content-center">
                
                <img src="~/images/logo.png" alt="Logo Shorty" style="height: 3em; width: auto;" class="me-3" />
            </h1>

            <p class="lead text-muted mb-5">
                Transforme links gigantes em atalhos curtos e elegantes.
            </p>

            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    
                    <form asp-action="Encurtar" method="post">
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white border-end-0">
                                🔗 </span>
                            
                            <input type="url" 
                                   name="urlOriginal" 
                                   class="form-control border-start-0" 
                                   placeholder="Cole sua URL longa aqui (ex: https://...)" 
                                   required 
                                   value="@ViewBag.UrlOriginal" />
                            
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                Encurtar
                            </button>
                        </div>
                    </form>

                </div>
            </div>

            @if (ViewBag.UrlCurta != null)
            {
                <div class="alert alert-success mt-4 p-4 shadow-sm fade show" role="alert">
                    <h4 class="alert-heading mb-3">Seu link está pronto! 🎉</h4>
                    
                    <div class="d-flex justify-content-center align-items-center bg-white p-3 rounded border">
                        <a href="@ViewBag.UrlCurta" target="_blank" class="fs-4 fw-bold text-decoration-none text-success">
                            @ViewBag.UrlCurta
                        </a>
                    </div>
                    
                    <p class="mb-0 mt-2 text-muted small">Clique no link para testar</p>
                </div>
            }

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger mt-3 fade show">
                    ⚠️ @ViewBag.Erro
                </div>
            }

        </div>
    </div>
</div>